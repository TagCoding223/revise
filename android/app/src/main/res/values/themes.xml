<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Your main application theme -->
    <style name="Theme.ReviseApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Add this line to force dark icons in the status bar for light mode -->
        <item name="android:windowLightStatusBar">true</item>
        <!-- Main theme colors go here -->
    </style>

    <!-- The Modern Splash Screen Theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- The background color we defined above -->
        <item name="windowSplashScreenBackground">@color/splash_bg</item>

        <!-- Center your logo -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_app_logo</item>

        <!-- The theme to switch to once the app is loaded -->
        <item name="postSplashScreenTheme">@style/Theme.ReviseApp</item>
    </style>
</resources>